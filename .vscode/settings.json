{
  "[shellscript]": {
    "files.eol": "\n"
  },
  "files.eol": "auto",
  "findUnusedExports.detectCircularImports": true,
  "typescript.preferences.autoImportFileExcludePatterns": [
    "vue-router"
  ],
  "[vue]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "vue.server.includeLanguages": [
    "vue",
    "markdown"
  ]
}
