{
  "name": "vite-app-demo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build:staging": "vue-tsc --noEmit && vite build --mode staging",
    "build": "vite build --mode production",
    "preview": "vite preview --port=8443",
    "lint": "eslint --flag unstable_config_lookup_from_file --config eslint.config.mts --fix src/",
    "lint:check": "eslint --flag unstable_config_lookup_from_file --config eslint.config.mts --ext .js,.ts,.vue --ignore-pattern '.gitignore' --fix-dry-run src/",
    "format": "prettier . --write --ignore-path .gitignore",
    "format:check": "prettier . --check --ignore-path .gitignore",
    "lint:style": "stylelint ./src/**/*.{css,vue} --fix --ignore-path .gitignore",
    "lint:style:check": "stylelint ./src/**/*.{css,vue} --ignore-path .gitignore",
    "lint-staged": "lint-staged",
    "prepare": "cd .. && husky",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@primevue/themes": "^4.2.5",
    "@types/markdown-it": "^14.1.2",
    "@vee-validate/i18n": "^4.15.0",
    "@vee-validate/rules": "^4.15.0",
    "@vee-validate/yup": "^4.15.0",
    "@vueuse/components": "^12.4.0",
    "@vueuse/core": "^12.4.0",
    "@vueuse/integrations": "^12.4.0",
    "accessible-nprogress": "^2.1.2",
    "dompurify": "^3.2.3",
    "fast-xml-parser": "^4.5.1",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-prism": "^2.3.0",
    "pinia": "^2.3.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.2.5",
    "tailwindcss-primeui": "^0.4.0",
    "vee-validate": "^4.15.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.0.1",
    "vue-router": "^4.5.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@algolia/client-search": "^5.19.0",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@csstools/css-tokenizer": "^3.0.3",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@iconify/json": "^2.2.296",
    "@intlify/unplugin-vue-i18n": "^6.0.3",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/typography": "^0.5.16",
    "@types/eslint-plugin-tailwindcss": "^3.17.0",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^22.10.7",
    "@typescript-eslint/parser": "^8.20.0",
    "@unhead/schema-org-vue": "^0.6.0",
    "@unhead/vue": "^1.11.18",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.0.2",
    "@vue/compiler-dom": "^3.5.13",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "browserslist": "^4.24.4",
    "cssnano": "^7.0.6",
    "cssnano-preset-advanced": "^7.0.6",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-tailwindcss": "^3.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "fp-ts": "^2.16.9",
    "globals": "^15.14.0",
    "happy-dom": "^16.6.0",
    "husky": "^9.1.7",
    "jiti": "^2.4.2",
    "lightningcss": "^1.29.1",
    "lint-staged": "^15.4.1",
    "markdown-it": "^14.1.0",
    "postcss": "^8.5.1",
    "postcss-import": "^16.1.0",
    "prettier": "^3.4.2",
    "rollup": "^4.30.1",
    "stylelint": "^16.13.2",
    "stylelint-config-recommended": "15.0.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard": "^37.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-auto-import": "^19.0.0",
    "unplugin-icons": "^22.0.0",
    "unplugin-vue-components": "^28.0.0",
    "unplugin-vue-markdown": "^28.0.0",
    "unplugin-vue-router": "^0.10.9",
    "vite": "^6.0.7",
    "vite-plugin-compression2": "^1.3.3",
    "vite-plugin-minify": "^2.1.0",
    "vite-plugin-pages": "^0.32.4",
    "vite-plugin-pages-sitemap": "^1.7.1",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-vue-meta-layouts": "^0.5.1",
    "vite-plugin-webfont-dl": "^3.10.4",
    "vitest": "^3.0.2",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0",
    "workbox-window": "^7.3.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx,vue}": [
      "eslint --flag unstable_config_lookup_from_file --config eslint.config.mts --ignore-pattern '.gitignore' --fix",
      "prettier --ignore-path .gitignore --write"
    ],
    "{!(package)*.json,*.code-snippets,.!(browserslist)*rc}": [
      "prettier --ignore-path .gitignore --parser json --write"
    ],
    "package.json": ["prettier --ignore-path .gitignore --parser json --write"],
    "*.md": ["prettier --ignore-path .gitignore --write"]
  },
  "cssnano": {
    "preset": "advanced"
  },
  "browserslist": [">= 0.25%"],
  "pnpm": {
    "overrides": {
      "deep-equal": "npm:@nolyfill/deep-equal@^1",
      "hasown": "npm:@nolyfill/hasown@^1",
      "isarray": "npm:@nolyfill/isarray@^1",
      "string.prototype.matchall": "npm:@nolyfill/string.prototype.matchall@^1",
      "is-core-module": "npm:@nolyfill/is-core-module@^1",
      "safe-buffer": "npm:@nolyfill/safe-buffer@^1"
    }
  }
}
